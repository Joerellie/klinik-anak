# ========================================================
# KONFIGURASI DATABASE KLINIK ANAK HAPPY
# ========================================================

# Pilihan 1: SUPABASE (PostgreSQL Cloud) - GRATIS & DIREKOMENDASIKAN
# Masukkan Connection String PostgreSQL dari Supabase Anda di sini:
# Dashboard Supabase -> Project Settings -> Database -> Connection String (URI)
# Format: postgresql://postgres.[project-ref]:[PASSWORD]@[HOST]:[PORT]/postgres
DATABASE_URL=

# Atau jika ingin menggunakan parameter terpisah Supabase:
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=

# Pilihan 2: MySQL Lokal (XAMPP)
# Jika DATABASE_URL di atas dikosongkan, sistem otomatis menggunakan MySQL XAMPP lokal
DB_HOST=localhost
DB_PORT=3306
DB_NAME=klinik_anak_happy
DB_USER=root
DB_PASS=
